{
  "name": "tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "audit:tools": "node --import tsx scripts/generate-tool-inventory.ts",
    "test:record": "node --import tsx scripts/record-browser-results.ts",
    "check:mongo": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./scripts/app-dns.mjs scripts/check-mongo.mjs",
    "check:config": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-config.mjs",
    "check:release": "npm run audit:tools && node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-release.mjs",
    "prebuild": "node scripts/prepare-heic-assets.mjs && node scripts/prepare-ocr-assets.mjs",
    "check:office:live": "node --env-file-if-exists=.env.local --import tsx scripts/check-native-office-quality.ts",
    "check:admin:live": "node --env-file-if-exists=.env.local scripts/check-local-admin.mjs",
    "setup:local": "node scripts/configure-local.mjs",
    "check:ai:live": "node --env-file-if-exists=.env.local --import tsx scripts/check-ai-live.ts",
    "test:e2e:cross": "playwright test --config playwright.cross-browser.config.ts",
    "check:ai:route:live": "node --env-file-if-exists=.env.local --import ./scripts/app-dns.mjs --import tsx scripts/check-ai-route-live.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.8.1",
    "@next/env": "^16.4.2",
    "@vercel/og": "^1.0.3",
    "bwip-js": "^4.11.2",
    "css-tree": "^3.2.1",
    "docx": "^9.7.1",
    "docx-preview": "^0.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "libheif-js": "1.23.5",
    "lucide-react": "^1.27.0",
    "mongodb": "^7.5.0",
    "next": "^16.4.2",
    "parse5": "8.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "spark-md5": "^3.0.2",
    "sql-formatter": "^15.9.0",
    "terser": "^5.51.2",
    "tesseract.js": "^5.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/bwip-js": "^3.2.3",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/spark-md5": "^3.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
