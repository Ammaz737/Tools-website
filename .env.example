# Copy to `.env` or `.env.local` and fill in values you need.
# Most tools run fully client-side and need no env vars.

# -----------------------------------------------------------------------------
# Site (SEO / sitemap canonical base)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# MongoDB Atlas (admin / tool usage stats / tool visibility)
# Without these, visibility/count persistence is unavailable.
# Admin login is configured independently with the two credentials below.
#
# Atlas setup:
# 1. Atlas → Database → Connect → Drivers → copy the SRV connection string
# 2. Replace <username> and <password> (URL-encode special chars in the password)
# 3. Network Access → allow only your development or deployment egress IPs
# 4. Database Access → user with readWrite on the target DB
# 5. Set MONGODB_DB to the database name you want this app to use
# 6. If admin shows DNS/SRV errors on Windows, run: npm run check:mongo
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=quiet-workshop

ADMIN_PASSWORD=
# Required independent random signing secret: at least 32 characters.
# Login stays disabled until BOTH password and signing secret are set.
ADMIN_SESSION_SECRET=
# Optional IP header overwritten by your trusted reverse proxy (e.g. x-real-ip).
# Leave blank for a shared login/AI quota. Never trust a client-supplied header.
RATE_LIMIT_IP_HEADER=

# -----------------------------------------------------------------------------
# AI tools (`POST /api/ai`) — pick one provider, or leave AI_PROVIDER=auto
# auto order: OpenAI → Ollama → Gemini → clear provider-not-configured error
# -----------------------------------------------------------------------------
AI_PROVIDER=auto

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Ollama (both required when using ollama / auto with Ollama)
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# For a running local installation, set URL=http://localhost:11434 and the
# exact installed model name above. No API key is needed for local Ollama.

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Configure only providers you intend to use. Keys stay server-side: never use
# NEXT_PUBLIC_ prefixes for credentials. auto selects one configured provider;
# it does not send failed prompts to another provider automatically.
# AI_PROVIDER accepts auto, openai, gemini or ollama.

# Optional explicit DNS servers (public IPs, comma separated); empty uses host DNS.
DNS_RESOLVER_SERVERS=

# Optional native Office rendering: private self-hosted Gotenberg (see docs/OFFICE_ENGINE_SETUP.md).
OFFICE_CONVERTER_URL=
OFFICE_CONVERTER_AUTH_HEADER=
OFFICE_CONVERTER_TIMEOUT_MS=30000

# Dedicated plagiarism service: not an LLM estimate. See docs/PLAGIARISM_SETUP.md.
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
COPYLEAKS_WEBHOOK_SECRET=
# Sandbox returns synthetic results. Live checks can consume credits.
COPYLEAKS_SANDBOX=true

# Shared UTC-day caps across all instances; failed attempts consume quota. Atlas required in production.
AI_DAILY_REQUEST_LIMIT=500
PLAGIARISM_DAILY_REQUEST_LIMIT=50

# Local authenticated Docker worker (npm run setup:local fills blank private slots).
OFFICE_CONVERTER_USERNAME=
OFFICE_CONVERTER_PASSWORD=

# Optional application-process DNS override when router SRV/TXT discovery fails.
# Blank uses system DNS; never changes Windows/Wi-Fi settings.
APP_DNS_SERVERS=
